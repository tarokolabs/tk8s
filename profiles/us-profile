gw=$(route -n | grep -e "^0.0.0.0 ")
export GWIF=${gw##* }
ips=$(ifconfig $GWIF | grep 'inet ')
export IP=$(echo $ips | cut -d' ' -f2 | cut -d':' -f2)
export NETID=${IP%.*}
export GW=$(route -n | grep -e '^0.0.0.0' | tr -s \ - | cut -d ' ' -f2)
# 平台 clone 位置（預設 ~/tk，放別處就改這行或先 export TK_HOME）
export TK_HOME="${TK_HOME:-$HOME/tk}"
export PATH="$HOME/bin:$TK_HOME/bin:$HOME/kind/bin:$PATH"


if [ ! -d $HOME/.kube ]; then
   mkdir $HOME/.kube
   touch $HOME/.kube/config
fi

