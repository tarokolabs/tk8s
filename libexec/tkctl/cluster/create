#!/usr/bin/env bash
source "$(dirname "$(realpath "$0")")/../../../lib/env.sh"

if [ "$1" == "" ]; then
   echo "kto <cluster name> [version]"
   echo    
   echo '[Cluster Name & Network ID List]
tk8s  -> 172.22.0.0/24
tkbp  -> 172.22.8.0/24
tkdt  -> 172.22.16.0/24  (與 tklh 同網段，不可同時存在)
tklh  -> 172.22.16.0/24
tkops -> 172.22.24.0/24
tkdev -> 172.22.32.0/24
tkha  -> 172.22.64.0/24
tdcs1 -> 172.22.160.0/24 (與 lkh5 同網段，不可同時存在)
lkh5  -> 172.22.160.0/24'
   echo
   echo '[K8S Version List]
1.36.4
1.37.0
（主要支援最新與次新 K8s minor；更舊版本可自行指定，節點 image 將以本地配方建置）'
   echo
   exit 1
fi

[ -d ${CLUSTERS_DIR}/$1 ] && echo "$1 cluster exist" && exit 1

export cn=${1}
[ "${2}" != "" ] && export KVER=${2}

tk_load_conf ${cn} || exit 1

[ "$(tk_kver_minor)" -lt 30 ] && echo "Version ${KVER} not support" && exit 1

sw=$(swapon --show)
[ "$sw" != "" ] && echo "pls turn off swapfile(/etc/fstab)" && exit 1

read -p "Are you sure ? " yn
[ "$yn" != "YES" ] && exit 1

# install / refresh cni plugins
# CNI_DIR 是「所有」叢集節點的 /opt/cni/bin bind mount 來源，cilium agent 也把 cilium-cni 放在這裡。
# 絕不能 rm -r 重建：刪掉 bind mount 的來源目錄會讓既有叢集節點內的 /opt/cni/bin 變成
# 指向已刪除 inode 的殘留掛載（mountinfo 顯示 //deleted），節點下次 crio/containerd 重啟或
# 節點重啟就找不到 cilium-cni 而 NotReady。改為解到暫存目錄後就地覆蓋檔案，目錄 inode 不動。
sudo mkdir -p ${CNI_DIR} && sudo chown $(id -un) ${CNI_DIR}
rm -rf /tmp/cni-plugins && mkdir -p /tmp/cni-plugins
curl -sL "$(curl -sL https://api.github.com/repos/containernetworking/plugins/releases/latest | \
jq -r '.assets[].browser_download_url' | grep 'linux-amd64.*.tgz$')" -o /tmp/cni-plugins.tgz &>/dev/null
tar xf /tmp/cni-plugins.tgz -C /tmp/cni-plugins && cp -a /tmp/cni-plugins/. ${CNI_DIR}/
rm -rf /tmp/cni-plugins.tgz /tmp/cni-plugins
echo "[cni version]" && ${CNI_DIR}/bridge --version && echo

which kubectl &>/dev/null
if [ "$?" != "0" ]; then
   curl -LO "https://dl.k8s.io/release/$(curl -L -s https://dl.k8s.io/release/stable.txt)/bin/linux/amd64/kubectl" &>/dev/null
   chmod +x kubectl; sudo mv kubectl /usr/local/bin/
   echo "kubectl ok"
fi

which cilium &>/dev/null
if [ "$?" != "0" ]; then
   curl -LO https://github.com/cilium/cilium-cli/releases/latest/download/cilium-linux-amd64.tar.gz &>/dev/null
   sudo tar xzvfC cilium-linux-amd64.tar.gz /usr/local/bin
   rm cilium-linux-amd64.tar.gz
fi

which kubeletctl &>/dev/null
if [ "$?" != "0" ]; then
   curl -LO https://github.com/cyberark/kubeletctl/releases/download/v1.13/kubeletctl_linux_amd64 &>/dev/null
   chmod a+x ./kubeletctl_linux_amd64 && sudo mv ./kubeletctl_linux_amd64 /tmp/kubeletctl
fi

k=$(ps aux | grep -v "kto $1" | grep 'kto ' | grep -v grep)
[ "$k" != "" ] && echo "pls wait another kto run to complete" && exit 1

if [ "$TKIND" == "K8S" ]; then

   echo "[${cn}:${KVER} Cluster Infrastructure]"          
   source ${TK_HOME}/libexec/tkctl/cluster/create-nodes ${cn} ${KVER}

   # for Alpine Linux (Host OS)
   ls -al /proc/sys/net/bridge/bridge-nf-call-iptables &>/dev/null
   [ "$?" != "0" ] && sudo modprobe br_netfilter 

   for n in ${LCTN}
   do
     tn=$(echo $n | cut -d ":" -f 2)

     cat /etc/os-release | grep 'Alpine Linux' &>/dev/null
     if [[ "$?" == "0" || "$(tk_kver_minor)" -gt 29 ]]; then
        sudo podman exec -it ${tn} update-alternatives --set iptables /usr/sbin/iptables-nft &>/dev/null
        [ "$?" == "0" ] && echo "iptables-nft set ok"
     fi 

     sudo podman exec -it ${tn} sysctl -w net.ipv4.ip_forward=1 &>/dev/null
     sudo podman exec ${tn} cp /usr/share/zoneinfo/Asia/Taipei /etc/localtime
     sudo podman cp /tmp/kubeletctl ${tn}:/usr/local/bin/ &>/dev/null
 
     if [ "$PROXY" != "" ]; then
        sudo podman exec -it ${tn} systemctl set-environment HTTP_PROXY=http://$PROXY:3128
        sudo podman exec -it ${tn} systemctl set-environment HTTPS_PROXY=http://$PROXY:3128
        sudo podman exec -it ${tn} systemctl set-environment NO_PROXY=localhost,127.0.0.1,10.0.0.0/8,.${cn}.k8s
        sudo podman exec -it ${tn} systemctl daemon-reload
        sudo podman exec -it ${tn} systemctl restart containerd.service
     fi
   done

   echo ""
   echo "[${cn}:${KVER} Cluster]"

   # api server audit log
   sudo mkdir -p ${CLUSTERS_DIR}/${cn}/logs/apiserver; sudo chmod -R 777 ${CLUSTERS_DIR}/${cn}/logs/
   sudo cp ${TK_HOME}/manifests/audit-policy.yaml ${CLUSTERS_DIR}/${cn}/logs/apiserver/

   # kube-vip
   export DNSIP=${SNID%.*}.10 
   if [ "$KUBEVIP" != "" ]; then
      cat ${TK_HOME}/templates/kubeadm/init-config-vip.yaml | envsubst | sudo tee ${CLUSTERS_DIR}/${cn}/init-config.yaml &>/dev/null
      cat ${TK_HOME}/manifests/kube-vip.yaml | envsubst > /tmp/kube-vip.yaml
      sudo podman cp /tmp/kube-vip.yaml ${cn}-control-plane:/etc/kubernetes/manifests/ &>/dev/null
   else
      cat ${TK_HOME}/templates/kubeadm/init-config-${KVER%.*}.yaml | envsubst | sudo tee ${CLUSTERS_DIR}/${cn}/init-config.yaml &>/dev/null
   fi
   sudo cp ${TK_HOME}/templates/containerd/containerd-config.yaml ${CLUSTERS_DIR}/${cn}/containerd-config.yaml

   # CRI-O：init-config 的 criSocket 從 containerd 換成 crio
   if [ "$K8SCRI" == "crio" ]; then
      sudo sed -i 's#unix:///run/containerd/containerd.sock#unix:///var/run/crio/crio.sock#' ${CLUSTERS_DIR}/${cn}/init-config.yaml
      grep -q "crio.sock" ${CLUSTERS_DIR}/${cn}/init-config.yaml && echo "criSocket -> crio ok"
   fi

   # --skip-phases=addon/kube-proxy
   sudo podman exec -it ${cn}-control-plane bash -c "kubeadm init --config=${NODE_TAROKO_DIR}/init-config.yaml --ignore-preflight-errors=SystemVerification" &>/tmp/kubeadm.out
   if [ "$?" == "0" ]; then
      echo "${cn}-control-plane ok"
      sleep 30

      mkdir -p ~/.kube 
      sudo podman cp ${cn}-control-plane:/etc/kubernetes/admin.conf ~/.kube/config
      sudo chown $(id -u):$(id -g) ~/.kube/config
      sudo cp ~/.kube/config ${CLUSTERS_DIR}/${cn}/
      sudo chmod 755 ${CLUSTERS_DIR}/${cn}/config

      if [ "$KUBEVIP" != "" ]; then
         nc -w 1 $KUBEVIP 6443 &>/dev/null
         [ "$?" != "0" ] && sleep 150
         kubectl get nodes &>/dev/null
         [ "$?" != "0" ] && echo "kube-vip exited" && exit 1
         echo "kube-vip ok" 
      fi

      CNI=""
      if [ "$K8SCNI" == "canal" ]; then   
         kubectl get configmap kube-proxy -n kube-system -o yaml 2>/dev/null | \
         sed 's/maxPerCore: null/maxPerCore: 0/g' | kubectl apply -f - &>/dev/null
         sleep 10
         kubectl wait -n kube-system pod -l k8s-app=kube-proxy --for=condition=Ready --timeout=120s
         if [ "$?" == "0" ]; then
            # ans=$(echo "${KVER%.*} < 1.30" | bc)
            #if [ "$ans" == "1" ]; then
            #   #curl -sL https://raw.githubusercontent.com/projectcalico/calico/v3.28.3/manifests/canal.yaml | kubectl apply -f - &>/dev/null
            #   kubectl apply -f ${TK_HOME}/wulin/yaml/canal.3.28.3.yaml &>/tmp/canal.3.28.3.out
            #else
               curl -sL https://raw.githubusercontent.com/projectcalico/calico/v3.31.5/manifests/canal.yaml | kubectl apply -f - &>/tmp/canal.3.31.3.out
            #fi
            sleep 10
            kubectl wait -n kube-system pod -l k8s-app=canal --for=condition=Ready --timeout=360s
            CNI="ok"
         fi 
      fi
      if [ "$K8SCNI" == "cilium" ]; then
         kubectl delete daemonset -n kube-system kube-proxy &>/dev/null

	 # If you prefer Cilium to use the CIDRs already assigned to nodes by the Kubernetes Controller Manager,
	 # use the kubernetes IPAM mode:
         # kube-proxy 已刪除，kubeProxyReplacement 為必要，並需明確指向 apiserver（SRVIP 來自 conf）
         # l2announcements 讓 LoadBalancer IP 可從叢集外（主機側）到達
         #
         # 效能組（前提：全部節點在同一 L2——podman bridge 天然滿足；跨主機（#24）時要重新評估）：
         # - routingMode=native + autoDirectNodeRoutes：去 VXLAN 封裝，節點間 pod 流量直接路由
         # - ipv4NativeRoutingCIDR：kubeadm podSubnet，此段不做 masquerade
         # - bpf.masquerade：SNAT 走 eBPF（與 KPR 成對，資料面不再依賴 iptables）
         # （bandwidthManager/BBR 實測不可用：容器節點的巢狀 netns 讀不到
         #   /proc/sys/net/core/default_qdisc，agent 會自動停用——故不設）
         # netkit datapath（取代 veth，實測南北向 +30%、pod-to-pod 持平）：
         # 需核心 ≥6.8，不足時退回 veth；此為建叢集時的 datapath 決策，
         # 既有叢集不可熱切（agent 拒絕與 veth endpoint 共存）
         # CILIUM_DATAPATH=auto（預設：核心 ≥6.8 用 netkit，否則 veth）| netkit | veth
         # 實測（#56）：gVisor 沙箱在 netkit 下完全沒有網路，要用 RuntimeClass gvisor 的叢集請設 veth
         export CILIUM_DATAPATH=${CILIUM_DATAPATH:-auto}
         DATAPATH="$CILIUM_DATAPATH"
         if [ "$DATAPATH" == "auto" ]; then
            KMAJ=$(uname -r | cut -d. -f1); KMIN=$(uname -r | cut -d. -f2 | cut -d- -f1)
            if [ "$KMAJ" -gt 6 ] 2>/dev/null || { [ "$KMAJ" -eq 6 ] && [ "$KMIN" -ge 8 ]; } 2>/dev/null; then
               DATAPATH="netkit"
            else
               echo "kernel $(uname -r) < 6.8: netkit unavailable, using veth datapath"; DATAPATH="veth"
            fi
         fi
         case "$DATAPATH" in
            netkit|veth) NETKIT="--set bpf.datapathMode=${DATAPATH}" ;;
            *) echo "CILIUM_DATAPATH=${CILIUM_DATAPATH} invalid (auto|netkit|veth)"; exit 1 ;;
         esac
         [ "$DATAPATH" == "netkit" ] && echo "cilium datapath: netkit (gVisor pods will have no network; CILIUM_DATAPATH=veth to enable)" \
                                     || echo "cilium datapath: veth"

         # Gateway API 由 cilium 內建的 controller 實作（不另裝 Envoy Gateway）：
         # cilium 要求 CRD 在安裝當下已存在才會啟用 gateway controller，故先裝 CRD。
         # channel 預設 experimental（標準集 + TCPRoute/UDPRoute/ListenerSet，cilium 1.20 皆支援）
         export GWAPI_VER=${GWAPI_VER:-v1.6.1}
         export GWAPI_CHANNEL=${GWAPI_CHANNEL:-experimental}
         GWAPI_URL="https://raw.githubusercontent.com/kubernetes-sigs/gateway-api/${GWAPI_VER}/config/crd/${GWAPI_CHANNEL}"
         GWAPI_OK="ok"
         for crd in gatewayclasses gateways httproutes grpcroutes referencegrants backendtlspolicies tlsroutes tcproutes udproutes listenersets; do
            kubectl apply --server-side -f ${GWAPI_URL}/gateway.networking.k8s.io_${crd}.yaml &>>/tmp/gwapi-crds.out || GWAPI_OK="failed (${crd})"
         done
         echo "Gateway API ${GWAPI_VER} CRD (${GWAPI_CHANNEL}) ${GWAPI_OK}"

         # gatewayAPI.externalTrafficPolicy=Local：cilium-envoy 本身是 DaemonSet，持有 L2 lease 的
         # 節點必有本地 envoy，不會有「有 lease 沒後端」丟包的問題；客戶端 IP 由 envoy 以
         # X-Forwarded-For 帶給後端（L7 proxy，後端看到的 TCP 來源是節點的 cilium_host IP）
         export CILIUM_VER=${CILIUM_VER:-1.20.2}
         cilium install --version ${CILIUM_VER} ${NETKIT} --set cgroup.autoMount.enabled=false \
                --set cgroup.hostRoot=/sys/fs/cgroup \
                --set securityContext.privileged=true \
                --set ipam.mode=kubernetes \
                --set k8s.requireIPv4PodCIDR=true \
                --set ipam.operator.clusterPoolIPv4MaskSize=24 \
                --set kubeProxyReplacement=true \
                --set k8sServiceHost=${SRVIP} \
                --set k8sServicePort=6443 \
                --set l2announcements.enabled=true \
                --set routingMode=native \
                --set autoDirectNodeRoutes=true \
                --set ipv4NativeRoutingCIDR=10.244.0.0/16 \
                --set bpf.masquerade=true \
                --set gatewayAPI.enabled=true \
                --set gatewayAPI.externalTrafficPolicy=Local &>/tmp/cilium${CILIUM_VER}.out

         cilium status --wait &>/tmp/cilium.status
         [ "$?" == "0" ] && echo "cilium ${CILIUM_VER} ok"

         # LoadBalancer IP 池與 L2 對外公告（取節點網段 .200-.219，避開節點 IP 與閘道）
         export LBNET=${NID%.*}
         cat ${TK_HOME}/manifests/cilium-lb.yaml | envsubst '${LBNET}' | kubectl apply -f - &>/tmp/cilium-lb.out
         [ "$?" == "0" ] && echo "cilium LB-IPAM (${LBNET}.200-219) ok"

         # GatewayClass cilium 由 operator 自動建立（gatewayAPI.gatewayClass.create=auto）
         kubectl wait gatewayclass cilium --for=condition=Accepted --timeout=120s &>/dev/null
         [ "$?" == "0" ] && echo "Gateway API (cilium; GatewayClass: cilium, externalTrafficPolicy: Local) ok" \
                         || echo "GatewayClass cilium not accepted (kubectl describe gatewayclass cilium)"

         CNI="ok"
      fi

      if [ "$CNI" == "ok" ]; then      
         echo "$K8SCNI ok"
         join=$(sudo podman exec -it "${cn}"-control-plane bash -c 'kubeadm token create --print-join-command' | tr -d '\r')
         ignore='--ignore-preflight-errors=SystemVerification'
         sudo podman ps > /tmp/${cn}-ctn.list

         for nn in ${cn}-master1 ${cn}-worker1 ${cn}-worker2 ${cn}-worker3
         do
            cat /tmp/${cn}-ctn.list | grep ${nn} &>/dev/null
            if [ "$?" == "0" ]; then
               sudo podman exec -it ${nn} bash -c "$join $ignore" &>/tmp/${nn}.out
               [ "$?" == "0" ] && echo "${nn} join ok" && kubectl label nodes ${nn} app=taroko &>/dev/null
            fi
         done

         #kubectl label node ${cn}-worker1 node-role.kubernetes.io/taroko-worker= &>/dev/null
         #kubectl label node ${cn}-worker2 node-role.kubernetes.io/taroko-gateway= &>/dev/null
         kubectl taint node ${cn}-control-plane node-role.kubernetes.io/control-plane:NoSchedule- &>/dev/null

         # patch coredns
         kubectl patch deployment coredns -n kube-system --patch-file ${TK_HOME}/manifests/coredns.yaml &>/dev/null
         [ "$?" == "0" ] && echo "coredns patch ok"

         echo ""
         echo "[${cn}:${KVER} Cluster Addon]"
         # RuntimeClass（crun、gvisor）兩種 runtime 共用一份 manifest：
         # - crio：crun 與 gVisor（runtime_type=vm 的 runsc handler）都烤在節點 image
         # - containerd：deploy-rc.sh 於此時安裝 gVisor（官方 shim 掛法）與 crun
         if [ "$K8SCRI" != "crio" ]; then
            # deploy-rc.sh 逐節點回報 crun/runsc 安裝結果（runsc FAILED 時 RuntimeClass gvisor 的 pod 會起不來）
            ${TK_HOME}/scripts/deploy-rc.sh 2>/dev/null | grep -E 'crun|runsc'
         fi
         kubectl apply -f ${TK_HOME}/manifests/runtimeclass.yaml &>/dev/null
         [ "$?" == "0" ] && echo "RuntimeClass gvisor & crun ok"

         # install Metrics Server
         [ -f /tmp/metrics.yaml ] && rm /tmp/metrics.yaml
         curl -sL https://github.com/kubernetes-sigs/metrics-server/releases/latest/download/components.yaml \
         | sed 's|15s|15s\n        - --kubelet-insecure-tls|g' > /tmp/metrics.yaml
         kubectl apply -f /tmp/metrics.yaml &>/tmp/metrics.out
         sleep 15
         kubectl wait -n kube-system pod -l k8s-app=metrics-server --for=condition=Ready --timeout=360s

         # install Local Path Provisioner
         # 上游 v0.0.37 deploy/local-path-storage.yaml 加兩處平台客製（見 manifests/ 檔頭）
         kubectl apply -f ${TK_HOME}/manifests/local-path-storage.0.0.37.yaml &>/tmp/local-path-storage.0.0.37.out
         [ "$?" == "0" ] && echo "Local Path Provisioner (${NODE_TAROKO_DIR}/storage) ok"

         # 管理主機（tkadm）與教學 registry（dkreg）屬教材範疇（wulin repo）——
         # 平台不內建，WULIN_DIR 有對應 manifest 才部署（kcn 已將 WULIN_DIR 掛進節點；
         # 預設 ${TAROKO_HOME}/wulin，見 lib/env.sh）
         if [ -f ${WULIN_DIR}/platform/tkadm/tkadm-dkreg.yaml ]; then
            kubectl create ns taroko &>/dev/null
            sudo mkdir -p ${CLUSTERS_DIR}/${cn}/{tkadm,users}
            sudo chmod 777 -R ${CLUSTERS_DIR}/${cn}
            sudo cp -R ${WULIN_DIR}/platform/tkadm/k8suser ${CLUSTERS_DIR}/${cn}/
            cp ${WULIN_DIR}/platform/tkadm/system.sh ${CLUSTERS_DIR}/${cn}/tkadm/system.sh
            cp ${WULIN_DIR}/platform/tkadm/ash.init ${CLUSTERS_DIR}/${cn}/tkadm/ash.init
            echo ${cn} > ${CLUSTERS_DIR}/${cn}/tkadm/cn.txt

            cat ${WULIN_DIR}/platform/tkadm/tkadm-dkreg.yaml | sed "s|k1|${cn}|g" | sed "s|10.98.0.10|${SNID%.*}.10|g" >${CLUSTERS_DIR}/${cn}/tkadm/tkadm.yaml
            kubectl apply -f ${CLUSTERS_DIR}/${cn}/tkadm/tkadm.yaml &>/tmp/tkadm.out
            sleep 60
            kubectl wait -n taroko pod -l app=tkadm --for=condition=Ready --timeout=360s

            # dkreg 認證 secret（default namespace）
            kubectl create secret docker-registry dkreg --docker-server=dkreg.taroko:5000 --docker-username=bigred --docker-password=bigred -n default &>/dev/null
            [ "$?" == "0" ] && echo "dkreg secret ok"
            kubectl patch serviceaccount default -n default -p '{"imagePullSecrets": [{"name": "dkreg"}]}' &>/dev/null
         else
            echo "wulin not found (${WULIN_DIR}): admin console (tkadm) & dkreg skipped"
            echo "  git clone https://github.com/tarokolabs/wulin.git ${WULIN_DIR}"
         fi

         ${TK_HOME}/libexec/tkctl/net/gateway-create ${cn}
         ${TK_HOME}/libexec/tkctl/net/setup ${cn}

         if [ "$K8SCRI" != "crio" ]; then
            ver=$(sudo podman exec ${cn}-worker1 containerd -v | cut -d' ' -f3)
            export CVER=${ver%%.*}
         fi

         for n in ${LCTN}
         do
            tn=$(echo $n | cut -d ":" -f 2)

            if [ "$K8SCRI" == "crio" ]; then
               # crio 不需要任何執行期設定：dkreg insecure registry、cgroup、
               # CNI 路徑全都烤在 image 的 crio.conf.d/10-taroko.conf 裡
               :
            else
               sudo podman cp ${TK_HOME}/templates/containerd/containerd-config-${CVER}.yaml ${tn}:containerd-config.yaml
               if [ "$CVER" == "v2" ]; then
                  sudo podman exec -it ${tn} mkdir -p /etc/containerd/certs.d/dkreg.taroko:5000
                  sudo podman cp ${TK_HOME}/templates/containerd/hosts ${tn}:/etc/containerd/certs.d/dkreg.taroko:5000/hosts.toml
               fi
               sudo podman exec -it ${tn} bash -c "cat containerd-config.yaml >> /etc/containerd/config.toml"
               sudo podman exec ${tn} systemctl restart containerd &>/dev/null
               [ "$?" == "0"  ] && echo "${tn} systemctl restart containerd ok"
            fi

            cat ${TK_HOME}/scripts/node.sh | envsubst '${SRVIP}'  > ${CLUSTERS_DIR}/${cn}/node.sh
            chmod +x ${CLUSTERS_DIR}/${cn}/node.sh
            sudo podman exec -it ${tn} ${NODE_TAROKO_DIR}/node.sh
         done

         # install prometheus & kube-state-metrics
	 #if [ "$PROM" == "true" ]; then
         #   sudo mkdir -p ${CLUSTERS_DIR}/${cn}/prometheus/; sudo chmod 777 -R ${CLUSTERS_DIR}/${cn}/prometheus/
         #   kubectl kustomize ${TK_HOME}/wulin/wk/prometheus/ | envsubst | kubectl apply -f - &>/dev/null
         #   [ "$?" == "0" ] && echo "Prometheus ok"
         #   kubectl apply -k tk/wulin/wk/kube-state-metrics/ &>/dev/null
         #   [ "$?" == "0" ] && echo "kube-state-metrics ok"       
         #fi

         rm ~/.ssh/{known_hosts,known_hosts.old} &>/dev/null
      
         echo -e "\n${cn}: take office"
      else
         echo -e "\n${cn}: pls set K8SCNI variable"
      fi
   fi
fi
if [ "$TKIND" == "DIP" ]; then

   echo "[${cn} Cluster Infrastructure]"
   source ${TK_HOME}/libexec/tkctl/cluster/create-nodes ${cn}

   echo -e "\n${cn}: take office"
fi
