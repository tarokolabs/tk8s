# Generated by tkctl for cluster $cluster. Edit cluster.yaml and re-run tkctl instead.
[Unit]
Description=tk8s cluster $cluster router (VyOS at $router_ip: the nodes' gateway and the apiserver load balancer)
PartOf=$cluster.target

[Container]
ContainerName=$cluster-router
Image=$router_image
# The container's hostname must be the one config.boot sets: VyOS runs sudo at every commit and a
# hostname it cannot resolve stalls the boot for minutes.
HostName=$cluster-router
Network=$cluster.network
IP=$router_ip
# tkctl.boot and the bootup scripts, rendered from cluster.yaml; VyOS writes config.boot and its archive here.
Volume=$state_dir/router:/opt/vyatta/etc/config
# VyOS wants the network stack and systemd as PID 1 (podman's systemd mode).
PodmanArgs=--privileged --systemd=always
# systemd's shutdown signal; the image sets it too.
StopSignal=SIGRTMIN+3
StopTimeout=30

[Service]
Restart=always

[Install]
WantedBy=$cluster.target
