# Generated by tkctl for cluster $cluster. Edit cluster.yaml and re-run tkctl instead.
[Unit]
Description=tk8s cluster $cluster apiserver load balancer (HAProxy at $lb_ip)
PartOf=$cluster.target

[Container]
ContainerName=$cluster-lb
Image=$haproxy_image
Network=$cluster.network
IP=$lb_ip
# The directory, not the file: haproxy.cfg is replaced by rename when a control plane is added or
# removed, and a bind mount of one file would keep showing the inode the container started with.
Volume=$state_dir/lb:/usr/local/etc/haproxy:ro
# The image's stop signal is SIGUSR1 (graceful: keep serving established connections for up to
# timeout client), so a cluster stop would end in podman's SIGKILL and a failed unit.
StopSignal=SIGTERM

[Service]
Restart=always

[Install]
WantedBy=$cluster.target
