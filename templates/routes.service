# Generated by tkctl. Host routes to the pod and service subnets of cluster $cluster
# through its first control plane; started with the target, so they survive a reboot.
[Unit]
Description=tk8s cluster $cluster host routes
PartOf=$cluster.target
Wants=$cp_name.service
After=$cp_name.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=ip route replace $pods via $cp_ip
ExecStart=ip route replace $services via $cp_ip
ExecStop=-ip route del $pods via $cp_ip
ExecStop=-ip route del $services via $cp_ip
