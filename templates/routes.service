# Generated by tkctl. Host routes to the pod and service subnets of cluster $cluster
# through its first control plane, and to each other node's pod /24 straight to that node
# (control-plane-1 does not forward TCP to pods on other nodes); started with the target, so
# they survive a reboot.
# bgp mode adds the apiserver VIP through the router (the host's kubeconfig points at it).
[Unit]
Description=tk8s cluster $cluster host routes
PartOf=$cluster.target
Wants=$cp_name.service
After=$cp_name.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=ip route replace $pods via $cp_ip$node_routes
ExecStart=ip route replace $services via $cp_ip$vip_start
ExecStop=-ip route del $pods via $cp_ip$node_routes_stop
ExecStop=-ip route del $services via $cp_ip$vip_stop
