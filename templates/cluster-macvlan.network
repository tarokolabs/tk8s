# Generated by tkctl for cluster $cluster: the nodes on the hosts' LAN, macvlan on $parent.
# Edit cluster.yaml and re-run tkctl instead.
[Network]
NetworkName=$cluster
Driver=macvlan
Options=parent=$parent
Subnet=$nodes
Gateway=$gateway
# The nodes' default route is the cluster's router (its address floats between the routers on
# the LAN), not the LAN gateway. no_default_route keeps netavark from adding the gateway too.
Options=no_default_route=1
PodmanArgs=--route 0.0.0.0/0,$router_ip
# No resolvers here: netavark serves no DNS on a macvlan network and refuses the setting; the
# containers carry their own resolvers (set in each .container).
