#!/bin/sh
# Generated by tkctl for cluster $cluster. VyOS runs this before it loads config.boot. tkctl
# renders tkctl.boot; a config.boot without VyOS's own version footer would be migrated at
# every boot (blocks added, the file rewritten), so the footer is appended here, by the VyOS
# that is about to load it.
cp /opt/vyatta/etc/config/tkctl.boot /opt/vyatta/etc/config/config.boot
/usr/libexec/vyos/system-versions-foot.py >> /opt/vyatta/etc/config/config.boot
