# Generated by tkctl. A macvlan shim so this host can reach the containers of cluster $cluster on
# its own LAN interface (macvlan keeps the parent interface and its children apart), the routes to
# the cluster's addresses through it, and the routes to the pod and service subnets through the
# first control plane (bgp mode adds the apiserver VIP through the router). Started with the
# target, so they survive a reboot.
[Unit]
Description=tk8s cluster $cluster host routes (shim $shim on $iface)
PartOf=$cluster.target
# the shim hangs off $iface: it has to be up and addressed first (a reboot)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=-ip link add $shim link $iface type macvlan mode bridge
ExecStart=ip link set $shim up
ExecStart=ip addr replace $shim_ip/32 dev $shim$range_routes
ExecStart=ip route replace $pods via $cp_ip dev $shim$node_routes
ExecStart=ip route replace $services via $cp_ip dev $shim$vip_start
ExecStop=-ip route del $pods via $cp_ip dev $shim$node_routes_stop
ExecStop=-ip route del $services via $cp_ip dev $shim$vip_stop$range_routes_stop
ExecStop=-ip link del $shim
