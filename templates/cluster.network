# Generated by tkctl for cluster $cluster. Edit cluster.yaml and re-run tkctl instead.
[Network]
NetworkName=$cluster
Subnet=$nodes
Gateway=$gateway
# The nodes' default route is the router, not the host bridge at $gateway; the bridge is the
# router's upstream. no_default_route keeps netavark from adding the bridge as a default too.
Options=no_default_route=1
PodmanArgs=--route 0.0.0.0/0,$router_ip
DNS=1.1.1.1
DNS=1.0.0.1
DNS=8.8.8.8
DNS=8.8.4.4
