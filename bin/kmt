#!/usr/bin/env bash
source "$(dirname "$(realpath "$0")")/../lib/env.sh"

[ "$1" == "" ] && echo "kmt (create|remove|list)" && exit 1

cn=$(cat .kube/config | grep ' cluster: ' | cut -d ':' -f 2 | tr -d ' ')

read -p "Are you sure (${cn})? " yn
[ "$yn" != "YES" ] && exit 1

nc -w 1 ${cn} 32200 &>/dev/null
[ "$?" != "0" ] && echo "pls start ${cn} cluster" && exit 1

case $1 in
    create)
        echo "create"
        ;;
    remove)
        echo "remove"
        ;;
    list)
        echo "list"
        ;;
    *)
      echo "kmt $1 error -> kmt [create|remove|list]"
      exit 1
esac
