#!/bin/bash
[ "$1" == "" ] && echo "kcn <cluster>" && exit 1

export cn=${1}
export HDIR=~
[ "${2}" != "" ] && export KVER=${2}

[ ! -f ~/tk/conf/${cn}.conf ] && echo "~/tk/conf/${cn}.conf not found" && exit 1

source ~/tk/conf/${cn}.conf
([ "$LCTN" == "" ] || [ "$TKIND" == "" ] || [ "$NTP" == "" ]) && echo "~/tk/conf/${cn}.conf error" && exit 1

# 教材（wulin repo）的掛載來源，掛進每個節點的 /opt/wulin
# 未設定 WULIN_DIR 時預設 ~/wulin；目錄不存在則建立空目錄並提示
export WULIN_DIR="${WULIN_DIR:-$HOME/wulin}"
if [ ! -d "$WULIN_DIR" ]; then
   echo "WULIN_DIR ($WULIN_DIR) not found: labs unavailable"
   echo "  git clone https://github.com/tarokolabs/wulin.git $WULIN_DIR"
   mkdir -p "$WULIN_DIR"
fi

# 節點 image：本地沒有先嘗試 GHCR 拉取，拉不到（離線或該版本未發佈）
# 就以同名配方本地建置（node/crio → images/taroko.crio；node/containerd → images/taroko）
# 基底 kindest/node 可公開拉取，全新環境不依賴任何私有 registry
if [[ "${IMG}" == ghcr.io/tarokolabs/tk8s/node/* || "${IMG%%:*}" == "localhost/taroko.crio" ]]; then
   if ! sudo podman image exists ${IMG} &>/dev/null; then
      if [[ "${IMG}" == ghcr.io/* ]] && sudo podman pull ${IMG} &>/tmp/node-img-pull.out; then
         echo "${IMG} pulled"
      else
         case "${IMG}" in
            */node/containerd:*) BDIR=~/tk/wulin/images/taroko ;;
            *)                   BDIR=~/tk/wulin/images/taroko.crio ;;
         esac
         echo "building ${IMG} (not available remotely; first build takes a few minutes)"
         sudo podman build --build-arg VER=${KVER} --force-rm -t ${IMG} ${BDIR} &>/tmp/node-img-build.out
         [ "$?" != "0" ] && echo "${IMG} build failed (see /tmp/node-img-build.out)" && exit 1
         echo "${IMG} build ok"
      fi
   fi
fi

# 共用唯讀 image store：主機上有才掛（見 wulin/images/taroko.crio/storage.conf）
SHARED_STORE=""
[ -d /opt/zfs/images/base ] && SHARED_STORE="--volume /opt/zfs/images/base:/var/lib/shared:ro"

# install cni
if [ ! -d ~/cni ]; then
   mkdir -p ~/cni
   curl -sL "$(curl -sL https://api.github.com/repos/containernetworking/plugins/releases/latest | \
   jq -r '.assets[].browser_download_url' | grep 'linux-amd64.*.tgz$')" -o ~/cni-plugins.tgz &>/dev/null
   tar xf ~/cni-plugins.tgz -C ~/cni; rm ~/cni-plugins.tgz
fi

sudo rm -r /opt/zfs/"$cn" &>/dev/null
sudo mkdir -p /opt/zfs/"$cn"/tkimg; sudo chmod -R 777 /opt/zfs/"$cn"

case "$NTP" in
  "Internal")
     sudo podman network ls | grep $1 &>/dev/null
     [ "$?" == "0" ] && echo "$1 cluster exist" && exit 1

     cat /etc/hosts | grep "${NID%.*}" &>/dev/null
     [ "$?" == "0" ] && echo "Network ID confict" && exit 1

     sudo podman network create ${cn} --driver=bridge --subnet=${NID} --gateway=${NGW} --disable-dns &>/dev/null
     [ "$?" != "0" ] && echo "$NID can not created" && exit 1
     echo "${cn} Network (Local:$NID) created"

     for c in ${LCTN}
     do
       cip=$(echo $c | cut -d':' -f1)
       ctn=$(echo $c | cut -d':' -f2)
       cm=$(echo $c | cut -d':' -f3)
       cc=$(echo $c | cut -d':' -f4)

       # The docker run --cgroupns=private command-line option in Docker 
       # specifies that a container should run in its own private cgroup namespace.
       controlVolume=$(sudo podman volume create --label ${ctn}=true ${ctn}-volume)       
       sudo podman run -itd \
         --name ${ctn} \
         --hostname ${ctn} \
         --cpus ${cc} \
         --memory ${cm} \
         --privileged \
         --net ${cn} \
         --ip ${cip} \
         --dns 8.8.8.8 --dns 168.95.1.1 \
         --env TZ=Asia/Taipei \
         --volume ${HDIR}/cni:/opt/cni/bin \
         --volume /lib/modules:/lib/modules:ro \
         --volume ${controlVolume}:/var:suid,exec,dev,rbind \
         --volume /opt/zfs/${cn}:/opt/zfs \
         --volume ${WULIN_DIR}:/opt/wulin \
         ${SHARED_STORE} \
         --cgroupns=private \
         $IMG bash &>/tmp/${ctn}.out
         [ "$?" != "0" ] && echo "${ctn} container created error" && exit 1
         echo "${ctn} container created ok"
     done
     ;;
  "External")
     for c in ${LCTN}
     do
       cnn=$(echo $c | cut -d':' -f1)
       cif=$(echo $c | cut -d':' -f2)
       nip=$(echo $c | cut -d':' -f3)
       cip=$(echo $c | cut -d':' -f4)
       ctn=$(echo $c | cut -d':' -f5)
       cm=$(echo $c | cut -d':' -f6)
       cc=$(echo $c | cut -d':' -f7)

       sudo podman ps -a | grep "${ctn}"
       [ "$?" == "0" ] && continue

       controlVolume=$(sudo podman volume create --label ${ctn}=true)
       sudo podman run -itd \
         --name ${ctn} \
         --hostname ${ctn} \
         --cpus ${cc} \
         --memory ${cm} \
         --privileged \
         --net none \
         --volume ${HDIR}/cni:/opt/cni/bin \
         --volume /lib/modules:/lib/modules:ro \
         --volume ${controlVolume}:/var:suid,exec,dev,rbind \
         --volume /opt/zfs/${cn}:/opt/zfs \
         --volume ${WULIN_DIR}:/opt/wulin \
         ${SHARED_STORE} \
         --cgroupns=private \
         $IMG bash &>/dev/null
         [ "$?" == "0" ] && echo -n "${ctn} container created"

         ctpid=$(sudo podman inspect ${ctn} --format "{{.State.Pid}}")
         sudo ip link add "tkif${cnn}" link ${cif} type macvlan mode bridge
         sudo ip link set "tkif${cnn}" netns $ctpid
         sudo podman exec -it ${ctn} bash -c "ip addr add ${cip} dev tkif${cnn}"
         sudo podman exec -it ${ctn} bash -c "ip link set dev tkif${cnn} up"
         sudo podman exec -it ${ctn} bash -c "ip route add default via ${NGW} dev tkif${cnn}"
         echo " ($cip)"
     done
     ;;
  *)
     echo "Netwrok Type Error"
     exit 1
     ;; 
esac
