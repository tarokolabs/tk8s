#!/bin/bash
source "$(dirname "$(realpath "$0")")/../lib/env.sh"

[ "$1" == "" ] && echo "kci cluster" && exit 1

[ ! -d ${CLUSTERS_DIR}/$1 ] && echo "$1 not exist" && exit 1

[ ! -f ${TK_HOME}/conf/${1}.conf ] && echo "${TK_HOME}/conf/${1}.conf not found" && exit 1
source ${TK_HOME}/conf/${1}.conf

#kubectl get nodes &>/dev/null
sudo podman ps -a | grep $1 | grep 'Up ' &>/dev/null 
[ "$?" == "0" ] && echo "$1 already Up" && exit 1

read -p "Are you sure ? " yn
[ "$yn" != "YES" ] && exit 1

if [ "$NTP" == "Internal" ]; then
   if [ "$TKIND" == "K8S" ]; then
      cp ${CLUSTERS_DIR}/$1/config ~/.kube/config
      for x in $LCTN
      do
        ctn=$(echo $x | cut -d':' -f2)
        sudo podman start ${ctn} &>/dev/null
        if [ "$?" == "0" ]; then
            echo "${x#*:} Up"
            ans=$(echo "${KVER%.*} > 1.29" | bc)
            alp=$(cat /etc/os-release | grep 'Alpine Linux')
            if [[ "$alp" != "" || "$ans" == "1" ]]; then
               sleep 5
               sudo podman exec -it ${ctn} update-alternatives --set iptables /usr/sbin/iptables-nft &>/dev/null
               [ "$?" == "0" ] && echo "iptables-nft set ok"
            fi
        else
            echo "${ctn} start failure" && exit 1
        fi
        sleep 10
        sudo podman exec ${ctn} crictl pods | grep "etcd-${1}-control-plane" &>/dev/null
        if [ "$?" == "0" ]; then
           echo "Please wait ${ctn} 30 seconds to start the operation." && sleep 30
        else
           echo "Please wait ${ctn} 15 seconds to start the operation." && sleep 15
        fi
        sudo podman exec ${ctn} crictl pods | grep 'Ready ' | tr -s ' ' > /tmp/${ctn}.pods
      done
   fi

   export DKREGIP=$(kubectl get svc dkreg -n taroko -o jsonpath='{.spec.clusterIP}')
   for x in $LCTN
   do
     ctn=$(echo $x | cut -d':' -f2)
     sudo podman exec ${ctn} bash -c "echo '$DKREGIP dkreg.taroko' >> /etc/hosts"
     [ "$?" == "0" ] && echo "$ctn /etc/hosts ok"
   done

   ${TK_HOME}/bin/kns ${1} &>/dev/null

   echo -e "\n$1: clock in"
fi

if [ "$NTP" == "External" ]; then
   for c in ${CTN}
   do
     cip=$(echo $c | cut -d':' -f1)
     ctn=$(echo $c | cut -d':' -f2)
     cif=${cn}${cip##*.}

     sudo podman exec ${ctn} ip a s | grep "${cif}" &>/dev/null
     if [ "$?" != "0" ]; then
        ctpid=$(sudo podman inspect ${ctn} --format "{{.State.Pid}}")
        sudo ip link add ${cif} link eth2 type macvlan mode bridge
        sudo ip link set ${cif} netns $ctpid
        sudo podman exec -it ${ctn} bash -c "\
        ip addr add ${cip}/24 dev ${cif}
        ip link set dev ${cif} up
        ip route add default via ${NGW} dev ${cif}"
     fi
   done
   echo -e "\n$1: clock in"
fi

