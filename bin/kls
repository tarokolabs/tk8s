#!/bin/bash
kn=$(sudo podman ps -a --format "{{.Names}} {{.Status}}" | cut -d ' ' -f 1,2 | tr '-' ' ' | grep -v 'plane' | cut -d ' ' -f1,3 | uniq | tr ' ' ':')
if [ "$kn" == "" ]; then
   echo "no clusters" && echo

   bl=$(ls -d /opt/zfs/*bak* 2>/dev/null)
   if [ "$bl" != "" ]; then
      echo "backup cluster"
      echo "--------------------------------------"
      echo -e "$bl\n"
   fi
   exit 1
fi

for n in $kn
do
  cn=$(echo $n | cut -d ':' -f 1)
  source ~/tk/conf/${cn}.conf &>/dev/null
  [ "$?" != "0" ] && continue

  KVER=$(cat /opt/zfs/${cn}/init-config.yaml | grep 'kubernetesVersion: ' | cut -d' ' -f2)

  if [ "$1" != "" ]; then
     echo $n | grep "${1}:" &>/dev/null
     if  [ "$?" == "0" ]; then
         echo "$n ($NTP:$KVER)"
         if [ "$NTP" == "Internal" ]; then
            echo "---------------------------------------------------------"
            cn=$(echo $n | cut -d ':' -f 1)
            [ -f /opt/zfs/${cn}/net.info ] && cat /opt/zfs/${cn}/net.info
         fi
         if [ "$NTP" == "External" ]; then
            echo "---------------------------------------------------------"
            for x in $ECTN
            do
              echo "$x" | tr ':' ' '
            done
         fi
         echo ""
     fi
  else
     echo "$n ($NTP:$KVER)" 

     echo "$n" | grep 'Up' &>/dev/null
     if [  "$?" == "0"  ]; then
        echo "---------------------------------------"
        kubectl get pods -A | tr -s ' ' | cut -d ' ' -f 1-5 | column -t
        echo ""
     fi
  fi
done

echo ""
bl=$(ls -d /opt/zfs/*bak* 2>/dev/null)
if [ "$bl" != "" ]; then
   echo "backup cluster"
   echo "--------------------------------------"
   echo -e "$bl\n"
fi
