#!/bin/bash
source "$(dirname "$(realpath "$0")")/../lib/env.sh"
[ "$1" == "" ] && echo "kcg <cluster>" && exit 1

export cn=${1}

[ ! -f ${TK_HOME}/conf/${cn}.conf ] && echo "${TK_HOME}/conf/${cn}.conf not found" && exit 1

source ${TK_HOME}/conf/${cn}.conf
([ "$LCTN" == "" ] || [ "$TKIND" == "" ] || [ "$NTP" == "" ]) && echo "${TK_HOME}/conf/${cn}.conf error" && exit 1

case "$NTP" in
  "Internal")
     sudo podman network ls | grep $1 &>/dev/null
     [ "$?" != "0" ] && echo "${cn} cluster not exist" && exit 1

     sudo podman ps | grep "${cn}-" | grep 'Up' &>/dev/null
     [ "$?" == "0" ] && echo "pls stop ${cn} first (kco ${cn})" && exit 1

     read -p "Are you sure ? " yn
     [ "$yn" != "YES" ] && exit 1

     KVER=$(cat ${CLUSTERS_DIR}/${cn}/init-config.yaml | grep 'kubernetesVersion: ' | cut -d' ' -f2)

     sudo rm -r ${CLUSTERS_DIR}/${cn}-bak-${KVER} &>/dev/null
     sudo mkdir -p ${CLUSTERS_DIR}/${cn}-bak-${KVER}/ && sudo chmod -R 777 ${CLUSTERS_DIR}/${cn}-bak-${KVER}/
     mdir=$(sudo podman info | grep volumePath | cut -d':' -f 2 | tr -d ' ')

     for c in ${LCTN}
     do
       ctn=$(echo $c | cut -d':' -f2)

       sudo podman images | grep "${ctn}:v${KVER}" &>/dev/null
       [ "$?" == "0" ] && sudo podman rmi -f "${ctn}:v${KVER}" &>/dev/null

       sudo podman commit ${ctn} ${ctn}:v${KVER} &>/dev/null
       if [ "$?" == "0" ]; then
         sudo podman save ${ctn}:v${KVER} > ${CLUSTERS_DIR}/${cn}-bak-${KVER}/${ctn}-v${KVER}.tar
         echo "${ctn}:v${KVER} image backup ok"

         sudo podman inspect --format='{{json .Config.CreateCommand}}' ${ctn} | jq -c | tr -d '[]' > /tmp/${ctn}.txt
         if [ "$?" == "0" ]; then
            tcmd=$(sed -e 's/\",\"/ /g' /tmp/${ctn}.txt | tr -d '"')
            tstr="s/quay.io\/cloudwalker\/taroko/localhost\/${ctn}/g"
            cmd=$(echo $tcmd | sed -e $tstr)
            echo "sudo $cmd" > ${CLUSTERS_DIR}/${cn}-bak-${KVER}/${ctn}-v${KVER}.sh
            sudo chmod +x ${CLUSTERS_DIR}/${cn}-bak-${KVER}/${ctn}-v${KVER}.sh
            echo "${ctn}:v${KVER} rebuild script ok"

            sudo tar cvf ${ctn}-volume.tar ${mdir}/${ctn}-volume/ &>/dev/null
            [ "$?" == "0" ] && sudo mv ${ctn}-volume.tar ${CLUSTERS_DIR}/${cn}-bak-${KVER}/ && echo "${ctn}-volume.tar ok"
         fi
       fi
     done
     sudo tar cvf ${cn}.tar ${CLUSTERS_DIR}/${cn}/ &>/dev/null
     [ "$?" == "0" ] && sudo mv ${cn}.tar ${CLUSTERS_DIR}/${cn}-bak-${KVER}/ && echo "${cn}.tar ok"
     echo ""
     echo "${cn} backup ok"

     ;;
  "External")
     for c in ${LCTN}
     do
       cnn=$(echo $c | cut -d':' -f1)
       cif=$(echo $c | cut -d':' -f2)
       nip=$(echo $c | cut -d':' -f3)
       cip=$(echo $c | cut -d':' -f4)
       ctn=$(echo $c | cut -d':' -f5)
       cm=$(echo $c | cut -d':' -f6)
       cc=$(echo $c | cut -d':' -f7)

     done
     ;;
  *)
     echo "Netwrok Type Error"
     exit 1
     ;;
esac
