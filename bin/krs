#!/bin/bash
[[ "$1" == "" || "$2" == "" ]] && echo "krs <cluster> <version>" && exit 1

cd ~

sw=$(swapon --show)
[ "$sw" != "" ] && echo "pls turn off swapfile(/etc/fstab)" && exit 1

sudo podman network ls | grep $1 &>/dev/null
[ "$?" == "0" ] && echo "pls remove $1 cluster first (kgn $1)" && exit 1

export cn=${1}
export KVER=${2}

[ ! -d /opt/zfs/${cn}-bak-${KVER}/ ] && echo "/opt/zfs/${cn}-bak-${KVER}/ not found" && exit 1

[ ! -f ~/tk/conf/${cn}.conf ] && echo "~/tk/conf/${cn}.conf not found" && exit 1
source ~/tk/conf/${cn}.conf

read -p "Are you sure ? " yn
[ "$yn" != "YES" ] && exit 1

# install cni
if [ ! -d ~/cni ]; then
   mkdir -p ~/cni
   curl -sL "$(curl -sL https://api.github.com/repos/containernetworking/plugins/releases/latest | \
   jq -r '.assets[].browser_download_url' | grep 'linux-amd64.*.tgz$')" -o ~/cni-plugins.tgz &>/dev/null
   tar xf ~/cni-plugins.tgz -C ~/cni; rm ~/cni-plugins.tgz
   echo "~/cni ok"
fi

which kubectl &>/dev/null
if [ "$?" != "0" ]; then
   curl -LO "https://dl.k8s.io/release/$(curl -L -s https://dl.k8s.io/release/stable.txt)/bin/linux/amd64/kubectl" &>/dev/null
   chmod +x kubectl; sudo mv kubectl /usr/local/bin/
   echo "kubectl ok"
fi

echo ""
for c in ${LCTN}
do
  ctn=$(echo $c | cut -d':' -f2)

  sudo podman images | grep ${ctn} &>/dev/null
  [ "$?" == "0" ] && sudo podman rmi "localhost/${ctn}:v${KVER}" &>/dev/null
  sudo podman load < /opt/zfs/${cn}-bak-${KVER}/${ctn}-v${KVER}.tar &>/dev/null
  [ "$?" == "0" ] && echo "localhost/${ctn}:v${KVER} image ok"
  sudo tar xvf /opt/zfs/${cn}-bak-${KVER}/${ctn}-volume.tar -C / &>/dev/null
  [ "$?" == "0" ] && echo "localhost/${ctn}:v${KVER} volume ok"
done

sudo tar xvf /opt/zfs/${cn}-bak-${KVER}/${cn}.tar -C / &>/dev/null
[ ! -d ~/.kube ] && mkdir ~/.kube
sudo cp /opt/zfs/${cn}/config ~/.kube/
sudo chown $(id -u):$(id -g) ~/.kube/config

sudo podman network ls | grep "${ctn}" &>/dev/null
[ "$?" != "0" ] && sudo podman network create ${cn} --driver=bridge --subnet=${NID} --gateway=${NGW} &>/dev/null

for c in ${LCTN}
do
  ctn=$(echo $c | cut -d':' -f2)

  /opt/zfs/${cn}-bak-${KVER}/${ctn}-v${KVER}.sh &>/dev/null
  [ "$?" == "0" ] && echo "${ctn} created ok"
  sleep 30
  ans=$(echo "${KVER%.*} > 1.29" | bc)
  alp=$(cat /etc/os-release | grep 'Alpine Linux')
  if [[ "$alp" != "" || "$ans" == "1" ]]; then
     sudo podman exec ${ctn} update-alternatives --set iptables /usr/sbin/iptables-nft &>/dev/null
     [ "$?" == "0" ] && echo "${ctn} iptables (nft) ok"
  fi
  sudo podman exec ${ctn} cp /opt/zfs/hosts /etc/hosts
  [ "$?" == "0" ] && echo "${ctn} /etc/hosts ok"
done

# /home/bigred/tk/bin/ksc ${cn}
# sleep 60
#kubectl wait -n kube-system pod -l k8s-app=metrics-server --for=condition=Ready --timeout=120s
#[ "$?" != "0" ] && kubectl delete -n kube-system pod -l k8s-app=metrics-server &>/dev/null && \
#kubectl wait -n kube-system pod -l k8s-app=metrics-server --for=condition=Ready --timeout=120s

RLCTN=$(echo ${LCTN} | tr ' ' '\n' | tac | tr '\n' ' ')
for c in ${RLCTN}
do
  ctn=$(echo $c | cut -d':' -f2)
  sudo podman stop ${ctn} -t=120 &>/dev/null
done

echo "${cn} restore ok"
