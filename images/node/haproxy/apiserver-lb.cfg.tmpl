# Node-local apiserver load balancer. Rendered by apiserver-lb.service with envsubst (TK_CLUSTER_DOMAIN
# from /etc/tk8s/apiserver-lb.env, mounted by tkctl into workers only). TCP passthrough to every control
# plane found through the SRV record; health checks over TLS; starts before the DNS answers.
global
    log stdout format raw local0
    stats socket /run/haproxy/admin.sock mode 600 level admin

defaults
    mode tcp
    log global
    option tcplog
    timeout connect 5s
    timeout client 10m
    timeout server 10m

resolvers dns
    parse-resolv-conf
    resolve_retries 3
    timeout resolve 2s
    timeout retry 2s
    hold valid 10s
    hold obsolete 120s
    hold nx 120s
    hold refused 120s
    hold timeout 120s
    hold other 120s

frontend apiserver
    bind 127.0.0.1:6443
    default_backend control-planes

frontend stats
    mode http
    bind 127.0.0.1:8404
    stats enable
    stats uri /stats

backend control-planes
    balance roundrobin
    option httpchk GET /readyz
    http-check expect status 200
    default-server check inter 2s fall 3 rise 2 check-ssl verify none init-addr none resolvers dns resolve-prefer ipv4
    server-template cp 5 _apiserver._tcp.${TK_CLUSTER_DOMAIN}
