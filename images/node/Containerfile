ARG VER=0.0
FROM docker.io/kindest/node:v${VER}

# FROM 之後要重新宣告才拿得到 build-arg
ARG VER
ARG CRIO_CHANNEL=stable
# 2026-07 起 pkgs.k8s.io 的 addons:/cri-o 路徑回 403（2026-08 複驗仍然如此），
# CRI-O deb 目前只剩上游 openSUSE Build Service 這個來源。做成 build-arg，
# 日後 pkgs.k8s.io 恢復時以 --build-arg CRIO_REPO=https://pkgs.k8s.io/addons:/cri-o 切回
ARG CRIO_REPO=https://download.opensuse.org/repositories/isv:/cri-o

# 與 taroko image 相同的除錯工具（gpg 是加 CRI-O repo 用的）
RUN apt-get update && apt-get upgrade -y
RUN apt-get install -y nano net-tools curl wget iputils-ping jq gpg zstd haproxy gettext-base
RUN rm /kind/manifests/*.yaml

# CRI-O 的 minor 版本必須對齊 K8s minor：VER=1.35.5 -> v1.35
# --force-confnew：cri-o 套件的 /etc/crictl.yaml 與 kind image 內建同名檔衝突，
# 不加會卡在 dpkg 的 conffile 互動提示（build 環境無 stdin 直接失敗）
RUN set -eux; \
    CRIO_URL="${CRIO_REPO}:/${CRIO_CHANNEL}:/v${VER%.*}/deb"; \
    mkdir -p /etc/apt/keyrings; \
    curl -fsSL "${CRIO_URL}/Release.key" \
      | gpg --dearmor -o /etc/apt/keyrings/cri-o-apt-keyring.gpg; \
    echo "deb [signed-by=/etc/apt/keyrings/cri-o-apt-keyring.gpg] ${CRIO_URL}/ /" \
      > /etc/apt/sources.list.d/cri-o.list; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install -y \
      -o Dpkg::Options::=--force-confnew cri-o; \
    rm -rf /var/lib/apt/lists/*

# gVisor is not baked in; addons:gvisor installs it into the node's persisted /usr/local/bin
# when the cluster is created with --gvisor.

# 節點 container 內 inotify 上限
RUN printf 'fs.inotify.max_user_instances=8192\nfs.inotify.max_user_watches=524288\n' \
      > /etc/sysctl.d/99-taroko-inotify.conf

COPY crio.conf.d/ /etc/crio/crio.conf.d/
COPY crictl.yaml /etc/crictl.yaml

# CRI-O 與 kubeadm 必須用同一個 sandbox（pause）image。CRI-O 內建的預設（1.36 是 pause:3.10.1）
# 會跟 kubeadm 列的（1.36.4 是 3.10.2）漂移；共用 image store 只有 kubeadm 列的那個，離線時
# CRI-O 拉不到自己的預設就建不出任何 pod sandbox。build 時從 kubeadm 讀，寫進獨立的 drop-in。
RUN set -eux; \
    pause=$(kubeadm config images list --kubernetes-version "v${VER}" | grep '/pause:'); \
    printf '# Written at image build: CRI-O uses the same pause image kubeadm %s lists.\n[crio.image]\npause_image = "%s"\n' "v${VER}" "$pause" \
      > /etc/crio/crio.conf.d/20-pause.conf; \
    cat /etc/crio/crio.conf.d/20-pause.conf
COPY storage.conf /etc/containers/storage.conf

# 每個 worker 自己的 apiserver LB：tkctl 只在 worker 掛進 /etc/tk8s/apiserver-lb.env，unit 的
# ConditionPathExists 因此只在 worker 成立；control plane 走主機側 LB。套件自帶的 haproxy.service
# 關掉，免得跟它搶 port。haproxy 一定要在 image 裡：節點重啟後根檔案系統回到 image，執行期
# apt 裝的東西會消失（/var 裡的 dpkg 資料庫卻記得已安裝）。
COPY haproxy/apiserver-lb.cfg.tmpl /etc/haproxy/apiserver-lb.cfg.tmpl
COPY systemd/apiserver-lb.service /etc/systemd/system/apiserver-lb.service
COPY systemd/kubelet.service.d/20-apiserver-lb.conf /etc/systemd/system/kubelet.service.d/20-apiserver-lb.conf
RUN systemctl disable haproxy.service && systemctl enable apiserver-lb.service

# 共用唯讀 image store 的掛載點（與主 store /var/lib/containers/storage 並排）。目錄必須先存在：
# 沒掛任何東西時它是空目錄，CRI-O 照常啟動（退化成沒有共用 store）；目錄不存在的話
# containers/storage 會報 can't stat imageStore dir，crio 起不來。
RUN mkdir -p /var/lib/containers/shared

# 換掉 CRI：關閉 containerd，改由 crio 提供 CRI socket。kind 在 /etc/default/kubelet 把 kubelet 的
# --runtime-cgroups 指向 containerd 的 cgroup；跟著換成 crio 的，否則 kubelet 每幾秒就報
# "Failed to get system container stats"。
RUN systemctl disable containerd.service && \
    systemctl enable crio.service && \
    sed -i 's#/system.slice/containerd.service#/system.slice/crio.service#' /etc/default/kubelet
