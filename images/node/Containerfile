# tk8s node image: Debian 13 with systemd as PID 1, CRI-O from its static bundle and the Kubernetes
# binaries from dl.k8s.io. Every artifact is pinned and checked against its published checksum, so
# the same VER and CRIO always build the same image. Nothing inherited from another node image: one
# runtime (CRI-O), no preloaded container images (nodes get those from the shared image store).
ARG VER=0.0
ARG CRIO=v0.0.0
FROM docker.io/library/debian:13-slim
ARG VER
ARG CRIO
ENV DEBIAN_FRONTEND=noninteractive

# OS: systemd (and dbus: CRI-O's systemd cgroup manager asks systemd for cgroups over sd-bus), the
# tools kubeadm's preflight and the kubelet need, and what a student needs inside a node.
RUN apt-get update && apt-get install -y --no-install-recommends \
      systemd systemd-sysv dbus ca-certificates curl iproute2 iptables nftables conntrack ethtool socat util-linux kmod procps \
      nano vim iputils-ping less jq tcpdump strace \
    && rm -rf /var/lib/apt/lists/*

# CRI-O static bundle: one tarball, one checksum, every tag stays downloadable (the GitHub release
# has no assets; the bundle is at storage.googleapis.com). Its install script puts crio, crictl and
# pinns in /usr/local/bin, crun/conmon/runc in /usr/libexec/crio, crio.service in
# /usr/local/lib/systemd/system, policy.json and crio.conf.d/10-crio.conf in /etc/crio, and
# registries.conf in /etc/containers/registries.conf.d. Its shebang lacks the "!", hence bash.
RUN set -eux; cd /tmp; \
    curl -fsSLO "https://storage.googleapis.com/cri-o/artifacts/cri-o.amd64.${CRIO}.tar.gz"; \
    curl -fsSLO "https://storage.googleapis.com/cri-o/artifacts/cri-o.amd64.${CRIO}.tar.gz.sha256sum"; \
    sha256sum -c "cri-o.amd64.${CRIO}.tar.gz.sha256sum"; \
    tar -xzf "cri-o.amd64.${CRIO}.tar.gz"; \
    cd cri-o && bash ./install && cd / && rm -rf /tmp/cri-o*; \
    ls -l /usr/local/bin/crio /usr/libexec/crio/crun /usr/local/lib/systemd/system/crio.service

# Kubernetes binaries with their published checksums.
RUN set -eux; cd /usr/local/bin; for b in kubeadm kubelet kubectl; do \
      curl -fsSLO "https://dl.k8s.io/release/v${VER}/bin/linux/amd64/${b}"; \
      echo "$(curl -fsSL "https://dl.k8s.io/release/v${VER}/bin/linux/amd64/${b}.sha256")  ${b}" | sha256sum -c -; \
      chmod 755 "${b}"; done

# kubelet: the standard kubeadm unit and drop-in; --runtime-cgroups points at crio.service.
COPY systemd/kubelet.service /etc/systemd/system/kubelet.service
COPY systemd/kubelet.service.d/ /etc/systemd/system/kubelet.service.d/
RUN echo 'KUBELET_EXTRA_ARGS=--runtime-cgroups=/system.slice/crio.service' > /etc/default/kubelet

# What kind's entrypoint did at start: rshared root and a unique product_uuid.
COPY systemd/tk8s-node-init.service /etc/systemd/system/tk8s-node-init.service
COPY sbin/tk8s-node-init /usr/local/sbin/tk8s-node-init

# CRI-O and container config of the platform.
COPY crio.conf.d/ /etc/crio/crio.conf.d/
COPY registries.conf.d/ /etc/containers/registries.conf.d/
COPY crictl.yaml /etc/crictl.yaml
COPY storage.conf /etc/containers/storage.conf

# CRI-O and kubeadm must use the same sandbox (pause) image: the shared store only holds the one
# kubeadm lists, and CRI-O's built-in default drifts from it. Read it from kubeadm at build time.
RUN set -eux; pause=$(kubeadm config images list --kubernetes-version "v${VER}" | grep '/pause:'); \
    printf '# Written at image build: CRI-O uses the same pause image kubeadm %s lists.\n[crio.image]\npause_image = "%s"\n' "v${VER}" "$pause" \
      > /etc/crio/crio.conf.d/20-pause.conf; \
    cat /etc/crio/crio.conf.d/20-pause.conf

# inotify limits inside the node container.
RUN printf 'fs.inotify.max_user_instances=8192\nfs.inotify.max_user_watches=524288\n' > /etc/sysctl.d/99-taroko-inotify.conf

# Mount point of the shared read-only image store (next to the main store /var/lib/containers/storage).
# It must exist: empty is fine (CRI-O starts without a shared store), missing makes crio fail to start.
RUN mkdir -p /var/lib/containers/shared

# systemd in a container: our units on, hardware and host-only units off.
RUN systemctl enable crio.service kubelet.service tk8s-node-init.service && \
    systemctl mask systemd-udevd.service systemd-udevd-kernel.socket systemd-udevd-control.socket \
      getty.target console-getty.service apt-daily.timer apt-daily-upgrade.timer e2scrub_all.timer fstrim.timer

# An empty machine-id makes systemd generate one on the first boot and persist it in the node's /etc
# volume: nodes must not share the one baked in at build time.
RUN : > /etc/machine-id

STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
