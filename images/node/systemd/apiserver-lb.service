# Node-local apiserver load balancer (HAProxy). Runs only where tkctl mounted
# /etc/tk8s/apiserver-lb.env, i.e. on workers; control planes talk to the host-side LB.
[Unit]
Description=Node-local apiserver load balancer (HAProxy)
ConditionPathExists=/etc/tk8s/apiserver-lb.env
After=network.target

[Service]
Type=notify
EnvironmentFile=/etc/tk8s/apiserver-lb.env
RuntimeDirectory=haproxy
ExecStartPre=/bin/sh -c 'envsubst < /etc/haproxy/apiserver-lb.cfg.tmpl > /run/haproxy/apiserver-lb.cfg'
ExecStartPre=/usr/sbin/haproxy -c -f /run/haproxy/apiserver-lb.cfg
ExecStart=/usr/sbin/haproxy -Ws -f /run/haproxy/apiserver-lb.cfg
ExecReload=/usr/sbin/haproxy -Ws -f /run/haproxy/apiserver-lb.cfg -c
Restart=always

[Install]
WantedBy=multi-user.target
