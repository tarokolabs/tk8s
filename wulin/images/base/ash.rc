if [ `whoami` == "root" ]; then
   [ -f "/usr/bin/ash.init" ] && source /usr/bin/ash.init
   [ -f "/usr/bin/ash.service" ] && source /usr/bin/ash.service
else
   if [ -f "/usr/bin/ash.start" ]; then
      gw=$(route -n | grep -e "^0.0.0.0 ")
      export GWIF=${gw##* }  
      ips=$(ifconfig $GWIF | grep 'inet ')
      export IP=$(echo $ips | cut -d' ' -f2 | cut -d':' -f2)
      export NETID=${IP%.*}  
      export GW=$(route -n | grep -e '^0.0.0.0' | tr -s \ - | cut -d ' ' -f2)
      export PS1='\u@\h:\w$ '
      export TZ=Asia/Taipei  
      alias pingdup='sudo arping -D -I eth0 -c 2 '
      alias ping='ping -c 4' 
      alias dir='ls -alh'

      source /usr/bin/ash.start
   fi
fi
