# ============================================================
# 憑證與環境狀態
# 憑證應於環境建置時生成，不進版控。
# ============================================================
wulin/cosign/
wulin/images/*/ssh/
wulin/images/*/talosconfig
wulin/images/*/htpasswd
wulin/images/*/.gitconfig

# 通用樣式（防止之後新增同類檔案）
*.key
*.pem
*.p12
*.pfx
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
talosconfig
kubeconfig
kubeconfig.*
*.kubeconfig
htpasswd
.netrc
.npmrc
*.jks
*.keystore

# ============================================================
# 二進位與發佈產物
# 第三方二進位改為從上游取得（附校驗碼），不隨 repo 散佈。
# 自行產生的發佈物走 GitHub Release assets，不用 Git LFS。
# ============================================================
*.jar
*.deb
*.zip
*.tar
*.tar.gz
*.tgz
*.rpm
*.iso
*.img

# ============================================================
# 建置與執行殘留
# ============================================================
wulin/ci-*/
*.save
*.temp

# ============================================================
# 作業系統與編輯器
# ============================================================
.DS_Store
*.swp
*~
